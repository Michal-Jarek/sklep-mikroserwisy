{
 "info": {
  "name": "Order Service",
  "description": "Żądania bezpośrednio do order-service z nagłówkami, które ustawia Gateway (X-User-Id, X-User-Roles, X-Request-Id). Każdy przebieg tworzy nowe zamówienia z nowym Idempotency-Key. Wymaga Cart, Product, Inventory i Shipping (prawdziwych albo atrap) z produktem w koszyku klienta userId.",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
 },
 "variable": [
  {
   "key": "baseUrl",
   "value": "http://localhost:8086"
  },
  {
   "key": "userId",
   "value": "11111111-1111-4111-8111-111111111111"
  },
  {
   "key": "otherUserId",
   "value": "22222222-2222-4222-8222-222222222222"
  },
  {
   "key": "checkoutKey",
   "value": ""
  },
  {
   "key": "orderId",
   "value": ""
  },
  {
   "key": "productId",
   "value": ""
  }
 ],
 "item": [
  {
   "name": "Złóż zamówienie (PAID)",
   "event": [
    {
     "listen": "prerequest",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.collectionVariables.set('checkoutKey', pm.variables.replaceIn('{{$guid}}'));"
      ]
     }
    },
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('201 PAID', () => { pm.response.to.have.status(201); pm.expect(pm.response.json().status).to.eql('PAID'); });",
       "const order = pm.response.json();",
       "pm.test('kwoty tekstem, waluta PLN, pozycje', () => { pm.expect(order.total).to.match(/^[0-9]+\\.[0-9]{2}$/); pm.expect(order.currency).to.eql('PLN'); pm.expect(order.items.length).to.be.above(0); pm.expect(order.userId).to.eql(pm.variables.get('userId')); });",
       "pm.test('bez numeru karty w odpowiedzi', () => pm.expect(pm.response.text()).not.to.include('4111111111111111'));",
       "pm.collectionVariables.set('orderId', order.id);",
       "pm.collectionVariables.set('productId', order.items[0].productId);"
      ]
     }
    }
   ],
   "request": {
    "method": "POST",
    "header": [
     {
      "key": "X-User-Id",
      "value": "{{userId}}"
     },
     {
      "key": "X-User-Roles",
      "value": "CUSTOMER"
     },
     {
      "key": "X-Request-Id",
      "value": "postman-order-{{$randomInt}}"
     },
     {
      "key": "Idempotency-Key",
      "value": "{{checkoutKey}}"
     },
     {
      "key": "Content-Type",
      "value": "application/json"
     }
    ],
    "url": "{{baseUrl}}/orders",
    "body": {
     "mode": "raw",
     "raw": "{\n  \"shippingMethod\": \"COURIER\",\n  \"shippingAddress\": {\n    \"firstName\": \"Anna\",\n    \"lastName\": \"Nowak\",\n    \"street\": \"ul. Prosta 1/2\",\n    \"postalCode\": \"00-001\",\n    \"city\": \"Warszawa\",\n    \"countryCode\": \"PL\"\n  },\n  \"payment\": {\n    \"cardNumber\": \"4111111111111111\"\n  }\n}"
    }
   }
  },
  {
   "name": "Ten sam klucz → to samo zamówienie",
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('201 i to samo id', () => { pm.response.to.have.status(201); pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('orderId')); });"
      ]
     }
    }
   ],
   "request": {
    "method": "POST",
    "header": [
     {
      "key": "X-User-Id",
      "value": "{{userId}}"
     },
     {
      "key": "X-User-Roles",
      "value": "CUSTOMER"
     },
     {
      "key": "X-Request-Id",
      "value": "postman-order-{{$randomInt}}"
     },
     {
      "key": "Idempotency-Key",
      "value": "{{checkoutKey}}"
     },
     {
      "key": "Content-Type",
      "value": "application/json"
     }
    ],
    "url": "{{baseUrl}}/orders",
    "body": {
     "mode": "raw",
     "raw": "{\n  \"shippingMethod\": \"COURIER\",\n  \"shippingAddress\": {\n    \"firstName\": \"Anna\",\n    \"lastName\": \"Nowak\",\n    \"street\": \"ul. Prosta 1/2\",\n    \"postalCode\": \"00-001\",\n    \"city\": \"Warszawa\",\n    \"countryCode\": \"PL\"\n  },\n  \"payment\": {\n    \"cardNumber\": \"4111111111111111\"\n  }\n}"
    }
   }
  },
  {
   "name": "Ten sam klucz, inny adres → 409 CONFLICT",
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('409 CONFLICT', () => { pm.response.to.have.status(409); pm.expect(pm.response.json().error).to.eql('CONFLICT'); pm.expect(pm.response.json().requestId).to.be.a('string'); });"
      ]
     }
    }
   ],
   "request": {
    "method": "POST",
    "header": [
     {
      "key": "X-User-Id",
      "value": "{{userId}}"
     },
     {
      "key": "X-User-Roles",
      "value": "CUSTOMER"
     },
     {
      "key": "X-Request-Id",
      "value": "postman-order-{{$randomInt}}"
     },
     {
      "key": "Idempotency-Key",
      "value": "{{checkoutKey}}"
     },
     {
      "key": "Content-Type",
      "value": "application/json"
     }
    ],
    "url": "{{baseUrl}}/orders",
    "body": {
     "mode": "raw",
     "raw": "{\n  \"shippingMethod\": \"COURIER\",\n  \"shippingAddress\": {\n    \"firstName\": \"Anna\",\n    \"lastName\": \"Nowak\",\n    \"street\": \"ul. Prosta 1/2\",\n    \"postalCode\": \"00-001\",\n    \"city\": \"Kraków\",\n    \"countryCode\": \"PL\"\n  },\n  \"payment\": {\n    \"cardNumber\": \"4111111111111111\"\n  }\n}"
    }
   }
  },
  {
   "name": "Szczegóły zamówienia",
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('200 i to samo zamówienie', () => { pm.response.to.have.status(200); const o = pm.response.json(); pm.expect(o.id).to.eql(pm.collectionVariables.get('orderId')); pm.expect(o.status).to.eql('PAID'); pm.expect(o).to.have.property('itemsTotal'); });"
      ]
     }
    }
   ],
   "request": {
    "method": "GET",
    "header": [
     {
      "key": "X-User-Id",
      "value": "{{userId}}"
     },
     {
      "key": "X-User-Roles",
      "value": "CUSTOMER"
     },
     {
      "key": "X-Request-Id",
      "value": "postman-order-{{$randomInt}}"
     }
    ],
    "url": "{{baseUrl}}/orders/{{orderId}}"
   }
  },
  {
   "name": "Lista własnych zamówień",
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('200 i zamówienie na liście', () => { pm.response.to.have.status(200); const ids = pm.response.json().items.map(o => o.id); pm.expect(ids).to.include(pm.collectionVariables.get('orderId')); });"
      ]
     }
    }
   ],
   "request": {
    "method": "GET",
    "header": [
     {
      "key": "X-User-Id",
      "value": "{{userId}}"
     },
     {
      "key": "X-User-Roles",
      "value": "CUSTOMER"
     },
     {
      "key": "X-Request-Id",
      "value": "postman-order-{{$randomInt}}"
     }
    ],
    "url": "{{baseUrl}}/orders?page=1&size=100"
   }
  },
  {
   "name": "Cudze zamówienie → 404",
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('404 NOT_FOUND', () => { pm.response.to.have.status(404); pm.expect(pm.response.json().error).to.eql('NOT_FOUND'); });"
      ]
     }
    }
   ],
   "request": {
    "method": "GET",
    "header": [
     {
      "key": "X-User-Id",
      "value": "{{otherUserId}}"
     },
     {
      "key": "X-User-Roles",
      "value": "CUSTOMER"
     },
     {
      "key": "X-Request-Id",
      "value": "postman-order-{{$randomInt}}"
