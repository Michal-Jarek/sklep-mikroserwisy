    "url": "{{baseUrl}}/orders/{{orderId}}"
   }
  },
  {
   "name": "Potwierdzenie zakupu dla Review (SERVICE)",
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('200 purchased: true', () => { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.eql({purchased: true}); });"
      ]
     }
    }
   ],
   "request": {
    "method": "GET",
    "header": [
     {
      "key": "X-User-Id",
      "value": "{{userId}}"
     },
     {
      "key": "X-User-Roles",
      "value": "SERVICE"
     },
     {
      "key": "X-Request-Id",
      "value": "postman-order-{{$randomInt}}"
     }
    ],
    "url": "{{baseUrl}}/orders/purchased?userId={{userId}}&productId={{productId}}"
   }
  },
  {
   "name": "Potwierdzenie zakupu bez SERVICE → 403",
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('403 FORBIDDEN', () => { pm.response.to.have.status(403); pm.expect(pm.response.json().error).to.eql('FORBIDDEN'); });"
      ]
