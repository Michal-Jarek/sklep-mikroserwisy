    {
      "name": "Katalog (publiczne)",
      "item": [
        {
          "name": "GET /categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "categories"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const list = pm.response.json();",
                  "pm.test('4 categories, each with id and name', () => { pm.expect(list.length).to.be.at.least(4); list.forEach(c => pm.expect(c).to.have.keys('id','name')); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const page = pm.response.json();",
                  "pm.test('page with items, page, size, total', () => pm.expect(page).to.have.keys('items','page','size','total'));",
                  "pm.test('price is text with 2 decimals (D3)', () => page.items.forEach(p => { pm.expect(p.price).to.be.a('string').and.match(/^[0-9]{1,8}\\.[0-9]{2}$/); pm.expect(p.currency).to.eql('PLN'); }));",
                  "if (page.items.length) pm.collectionVariables.set('productId', page.items[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /products — szukanie, filtr i sortowanie",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products?q=kubek&maxPrice=50&sort=PRICE_ASC&page=1&size=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "kubek"
                },
                {
                  "key": "maxPrice",
                  "value": "50"
                },
                {
                  "key": "sort",
                  "value": "PRICE_ASC"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "size",
                  "value": "5"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const items = pm.response.json().items;",
                  "pm.test('every result costs at most 50.00', () => items.forEach(p => pm.expect(parseFloat(p.price)).to.be.at.most(50)));",
                  "pm.test('sorted by price ascending', () => { for (let i = 1; i < items.length; i++) pm.expect(parseFloat(items[i].price)).to.be.at.least(parseFloat(items[i-1].price)); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /products/{id} — klient (z oceną i dostępnością)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{customerUserId}}"
              },
              {
                "key": "X-User-Roles",
                "value": "CUSTOMER"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "{{productId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const p = pm.response.json();",
                  "pm.test('ProductDetail fields', () => pm.expect(p).to.include.keys('id','name','description','price','currency','category','imageUrl','rating','availability','createdAt','updatedAt'));",
                  "pm.test('rating and availability are an object or null (Review / Inventory may be down)', () => { pm.expect(p.rating === null || typeof p.rating === 'object').to.be.true; pm.expect(p.availability === null || typeof p.availability === 'object').to.be.true; });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /products/{id} — lekki odczyt dla usług (D4)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Roles",
                "value": "SERVICE"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "{{productId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const p = pm.response.json();",
                  "pm.test('id, name, price, currency', () => pm.expect(p).to.include.keys('id','name','price','currency'));",
                  "pm.test('no rating and no availability with SERVICE', () => { pm.expect(p.rating).to.be.null; pm.expect(p.availability).to.be.null; });"
                ]
              }
            }
          ]
        }
      ]
