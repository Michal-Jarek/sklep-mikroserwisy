              "path": [
                "products"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Kubek termiczny\",\n  \"description\": \"Kubek 400 ml.\",\n  \"price\": \"39.99\",\n  \"currency\": \"PLN\",\n  \"categoryId\": \"{{kitchenCategoryId}}\",\n  \"imageUrl\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "const p = pm.response.json();",
                  "pm.test('new product, no reviews, no stock yet', () => { pm.expect(p.name).to.eql('Kubek termiczny'); pm.expect(p.price).to.eql('39.99'); pm.expect(p.rating).to.eql({average: null, count: 0}); pm.expect(p.availability).to.be.null; });",
                  "pm.collectionVariables.set('createdProductId', p.id);"
                ]
              }
            }
          ]
        },
