{
  "info": {
    "name": "api-gateway",
    "description": "API Gateway, the single entry point to the backend. Folder start: new customer and admin login (run once per run). Folder direct: health straight at {{baseUrl}}. Folder via Gateway: access rules and paths through {{gatewayUrl}}. Auth through the Gateway is in the auth-service collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "start",
      "description": "Identical in all 10 service collections. Registers a new customer, logs in the customer and the admin, and keeps customerToken, customerId, customerEmail and adminToken in the environment. The runner runs it once per run.",
      "item": [
        {
          "name": "Register a new customer",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A new customer on every run: random e-mail and random password (24 characters; Auth needs 10-72 bytes).",
                  "// The password lives only in a local variable of this run (pm.variables), never in the environment.",
                  "const chars = 'abcdefghijkmnopqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ23456789';",
                  "const random = (n) => Array.from({ length: n }, () => chars[Math.floor(Math.random() * chars.length)]).join('');",
                  "pm.variables.set('customerPassword', random(24));",
                  "pm.environment.set('customerEmail', `postman-${Date.now().toString(36)}-${random(8).toLowerCase()}@sklep.local`);",
                  "['customerToken', 'customerId', 'adminToken'].forEach((name) => pm.environment.unset(name));",
                  "pm.request.body.update(JSON.stringify({",
                  "  email: pm.environment.get('customerEmail'),",
                  "  password: pm.variables.get('customerPassword'),",
                  "  firstName: 'Postman',",
                  "  lastName: 'Customer',",
                  "}));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const account = pm.response.json();",
                  "pm.test('account: id UUID, the generated e-mail, roles [\"CUSTOMER\"], no tokens in the body', () => {",
                  "  pm.expect(account.id, 'id').to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/);",
                  "  pm.expect(account.email, 'email').to.eql(pm.environment.get('customerEmail'));",
                  "  pm.expect(account.roles, 'roles').to.eql(['CUSTOMER']);",
                  "  pm.expect('accessToken' in account, 'accessToken in the body').to.be.false;",
                  "});",
                  "pm.environment.set('customerId', account.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gatewayUrl}}/auth/register",
            "description": "New customer of this run (e-mail postman-<random>@sklep.local). The body is built in the pre-request script.",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Log in as the customer",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.request.body.update(JSON.stringify({",
                  "  email: pm.environment.get('customerEmail'),",
                  "  password: pm.variables.get('customerPassword'),",
                  "}));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Payload of a JWT (base64url). Only the claims are checked; the token is never printed or compared by value.",
                  "const decodeBase64 = require('atob');",
                  "const jwtClaims = (token) => {",
                  "  const part = token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');",
                  "  return JSON.parse(decodeBase64(part + '='.repeat((4 - (part.length % 4)) % 4)));",
                  "};",
                  "",
                  "            pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "            const login = pm.response.json();",
                  "            pm.test('Bearer access token of the new customer (sub = customerId, roles [\"CUSTOMER\"])', () => {",
                  "              pm.expect(login.tokenType, 'tokenType').to.eql('Bearer');",
                  "              pm.expect(login.accessToken, 'accessToken').to.be.a('string');",
                  "              pm.expect(login.accessToken.split('.').length, 'parts of the JWT').to.eql(3);",
                  "              const claims = jwtClaims(login.accessToken);",
                  "              pm.expect(claims.sub, 'sub').to.eql(pm.environment.get('customerId'));",
                  "              pm.expect(claims.roles, 'roles').to.eql(['CUSTOMER']);",
                  "            });",
                  "            // Only the attributes are compared; the cookie value is never printed. The cookie stays in the cookie jar.",
                  "            pm.test('Set-Cookie refresh_token: HttpOnly, Secure, SameSite=Strict, Path=/api/v1/auth', () => {",
                  "              const parts = (pm.response.headers.get('Set-Cookie') || '').split(';').map((part) => part.trim());",
                  "              pm.expect(/^refresh_token=[^\\s]+$/.test(parts[0]), 'refresh_token cookie').to.be.true;",
                  "              ['HttpOnly', 'Secure', 'SameSite=Strict', 'Path=/api/v1/auth'].forEach((attribute) => {",
                  "                pm.expect(parts.slice(1).includes(attribute), attribute).to.be.true;",
                  "              });",
                  "            });",
                  "            if (typeof login.accessToken === 'string') {",
                  "              pm.environment.set('customerToken', login.accessToken);",
                  "            }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gatewayUrl}}/auth/login",
            "description": "Login 1 of 2 in a run (the Gateway allows 5 per minute per client address).",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Log in as admin",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// The body is built here, so any character of the password stays valid JSON.",
                  "pm.request.body.update(JSON.stringify({ email: pm.variables.get('adminEmail'), password: pm.variables.get('adminPassword') }));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Payload of a JWT (base64url). Only the claims are checked; the token is never printed or compared by value.",
                  "const decodeBase64 = require('atob');",
                  "const jwtClaims = (token) => {",
                  "  const part = token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');",
                  "  return JSON.parse(decodeBase64(part + '='.repeat((4 - (part.length % 4)) % 4)));",
                  "};",
                  "",
                  "            pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "            const login = pm.response.json();",
                  "            pm.test('Bearer access token with the role ADMIN', () => {",
                  "              pm.expect(login.tokenType, 'tokenType').to.eql('Bearer');",
                  "              pm.expect(login.accessToken, 'accessToken').to.be.a('string');",
                  "              pm.expect(jwtClaims(login.accessToken).roles, 'roles').to.include('ADMIN');",
                  "            });",
                  "            if (typeof login.accessToken === 'string') {",
                  "              pm.environment.set('adminToken', login.accessToken);",
                  "            }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gatewayUrl}}/auth/login",
            "description": "Login 2 of 2 in a run. adminEmail and adminPassword come from the environment (the password only from the runner, never in a file). Cookie jar disabled: the refresh_token cookie of the admin must not replace the one of the customer (same path).",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "protocolProfileBehavior": {
            "disableCookies": true
          }
        }
      ]
    },
    {
      "name": "direct",
      "description": "Health of the Gateway, straight at {{baseUrl}} (http://api-gateway:8080 in the network sklep_backend). Through the shop entrance /health/* is answered by nginx of the frontend, not by the Gateway.",
      "item": [
        {
          "name": "Liveness",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('body is {\"status\":\"UP\"}', () => pm.expect(pm.response.json()).to.eql({ status: 'UP' }));",
                  "pm.test('no X-Instance-Id header (set only by the services behind the Gateway)', () => pm.expect(pm.response.headers.has('X-Instance-Id')).to.be.false);",
                  "pm.test('X-Request-Id header is set', () => pm.expect(pm.response.headers.get('X-Request-Id')).to.be.a('string').and.not.empty);",
                  "pm.test('X-Gateway-Instance-Id header starts with api-gateway-', () => pm.expect(pm.response.headers.get('X-Gateway-Instance-Id')).to.match(/^api-gateway-/));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/live",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                "live"
              ]
            },
            "description": "The process is alive; dependencies are not checked."
          }
        },
        {
          "name": "Readiness",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('body is {\"status\":\"UP\"}', () => pm.expect(pm.response.json()).to.eql({ status: 'UP' }));",
                  "pm.test('no X-Instance-Id header (set only by the services behind the Gateway)', () => pm.expect(pm.response.headers.has('X-Instance-Id')).to.be.false);",
                  "pm.test('X-Request-Id header is set', () => pm.expect(pm.response.headers.get('X-Request-Id')).to.be.a('string').and.not.empty);",
                  "pm.test('X-Gateway-Instance-Id header starts with api-gateway-', () => pm.expect(pm.response.headers.get('X-Gateway-Instance-Id')).to.match(/^api-gateway-/));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/ready",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                "ready"
              ]
            },
            "description": "Ready when the configuration from Consul KV is loaded; otherwise 503 SERVICE_UNAVAILABLE. Redis, Consul (after loading) and Auth Service are not required."
          }
        }
      ],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// shop:direct-request-id",
              "// A new X-Request-Id for every request (the Gateway sets it in production); kept when the request sets its own.",
              "const sent = pm.request.headers.get('X-Request-Id');",
              "if (!sent) {",
              "  pm.request.headers.upsert({ key: 'X-Request-Id', value: pm.variables.replaceIn('{{$guid}}') });",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// shop:error-format",
              "// Every error of a service: {status (= HTTP code), error, message, requestId = the sent X-Request-Id}.",
              "// Not for Mailpit and the RabbitMQ management API (other formats).",
              "const url = pm.variables.replaceIn(pm.request.url.toString());",
              "const external = ['mailpitUrl', 'rabbitmqUrl'].some((name) => {",
              "  const base = pm.variables.get(name);",
              "  return Boolean(base) && url.startsWith(base);",
              "});",
              "if (!external && pm.response.code >= 400) {",
              "  pm.test(`error ${pm.response.code} in the team format, requestId = sent X-Request-Id`, () => {",
              "    const body = pm.response.json();",
              "    pm.expect(body.status, 'status').to.eql(pm.response.code);",
              "    pm.expect(body.error, 'error').to.be.a('string').and.not.empty;",
              "    pm.expect(body.message, 'message').to.be.a('string').and.not.empty;",
              "    pm.expect(body.requestId, 'requestId').to.eql(pm.variables.replaceIn(pm.request.headers.get('X-Request-Id')));",
              "  });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "via Gateway",
      "description": "Through the shop entrance ({{gatewayUrl}}) with the tokens from start: access rules and path checks of the Gateway.",
      "item": [
        {
          "name": "Own profile with a token (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('answered by User Service (X-Instance-Id user-service-...)', () => pm.expect(pm.response.headers.get('X-Instance-Id')).to.match(/^user-service-/));",
                  "pm.test('X-Gateway-Instance-Id header starts with api-gateway-', () => pm.expect(pm.response.headers.get('X-Gateway-Instance-Id')).to.match(/^api-gateway-/));",
                  "pm.test('profile of the customer from start (X-User-Id set by the Gateway from the token)', () => {",
                  "  const profile = pm.response.json();",
                  "  pm.expect(profile.id, 'id').to.eql(pm.environment.get('customerId'));",
                  "  pm.expect(profile.email, 'email').to.eql(pm.environment.get('customerEmail'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": "{{gatewayUrl}}/users/me",
            "description": "The token is valid: the Gateway sets X-User-Id from it and User Service answers with the profile of that user (created at registration)."
          }
        },
        {
          "name": "Own profile without a token (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401', () => pm.response.to.have.status(401));",
                  "const body = pm.response.json();",
                  "pm.test('Gateway error 401 UNAUTHORIZED in the team format', () => {",
                  "  pm.expect(body).to.eql({ status: 401, error: 'UNAUTHORIZED', message: 'Missing or invalid access token', requestId: pm.response.headers.get('X-Request-Id') });",
                  "});",
                  "pm.test('no X-Instance-Id (the answer of the Gateway, not of a service)', () => pm.expect(pm.response.headers.has('X-Instance-Id')).to.be.false);",
                  "pm.test('X-Gateway-Instance-Id header starts with api-gateway-', () => pm.expect(pm.response.headers.get('X-Gateway-Instance-Id')).to.match(/^api-gateway-/));",
                  "",
                  "pm.test('WWW-Authenticate: Bearer', () => pm.expect(pm.response.headers.get('WWW-Authenticate')).to.eql('Bearer'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gatewayUrl}}/users/me",
            "description": "Route /users/me/** requires a logged-in user; the Gateway answers before any service."
          }
        },
        {
          "name": "Own profile with a forged X-User-Roles and no token (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401', () => pm.response.to.have.status(401));",
                  "const body = pm.response.json();",
                  "pm.test('Gateway error 401 UNAUTHORIZED in the team format', () => {",
                  "  pm.expect(body).to.eql({ status: 401, error: 'UNAUTHORIZED', message: 'Missing or invalid access token', requestId: pm.response.headers.get('X-Request-Id') });",
                  "});",
                  "pm.test('no X-Instance-Id (the answer of the Gateway, not of a service)', () => pm.expect(pm.response.headers.has('X-Instance-Id')).to.be.false);",
                  "pm.test('X-Gateway-Instance-Id header starts with api-gateway-', () => pm.expect(pm.response.headers.get('X-Gateway-Instance-Id')).to.match(/^api-gateway-/));",
                  "",
                  "pm.test('WWW-Authenticate: Bearer', () => pm.expect(pm.response.headers.get('WWW-Authenticate')).to.eql('Bearer'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Roles",
                "value": "ADMIN"
              }
            ],
            "url": "{{gatewayUrl}}/users/me",
            "description": "The only request with an X-User-* header in the via Gateway folders: a client cannot pass identity headers; without a token the Gateway answers 401."
          }
        },
        {
          "name": "Create a product as a customer (403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 403', () => pm.response.to.have.status(403));",
                  "const body = pm.response.json();",
                  "pm.test('Gateway error 403 FORBIDDEN in the team format', () => {",
                  "  pm.expect(body).to.eql({ status: 403, error: 'FORBIDDEN', message: 'Insufficient role', requestId: pm.response.headers.get('X-Request-Id') });",
                  "});",
                  "pm.test('no X-Instance-Id (the answer of the Gateway, not of a service)', () => pm.expect(pm.response.headers.has('X-Instance-Id')).to.be.false);",
                  "pm.test('X-Gateway-Instance-Id header starts with api-gateway-', () => pm.expect(pm.response.headers.get('X-Gateway-Instance-Id')).to.match(/^api-gateway-/));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gatewayUrl}}/products",
            "description": "POST /products requires the role ADMIN; the token of the customer has CUSTOMER.",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Internal endpoint POST /users (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 404', () => pm.response.to.have.status(404));",
                  "const body = pm.response.json();",
                  "pm.test('Gateway error 404 NOT_FOUND in the team format', () => {",
                  "  pm.expect(body).to.eql({ status: 404, error: 'NOT_FOUND', message: 'Not found', requestId: pm.response.headers.get('X-Request-Id') });",
                  "});",
                  "pm.test('no X-Instance-Id (the answer of the Gateway, not of a service)', () => pm.expect(pm.response.headers.has('X-Instance-Id')).to.be.false);",
                  "pm.test('X-Gateway-Instance-Id header starts with api-gateway-', () => pm.expect(pm.response.headers.get('X-Gateway-Instance-Id')).to.match(/^api-gateway-/));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gatewayUrl}}/users",
            "description": "Internal endpoint (role SERVICE only): blocked from outside with the same answer as an unknown route, also with a token.",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Path with %2e%2e (400; 401 in k8s)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// compose (http, nginx passes the path as is): the Gateway rejects the non-canonical path with 400.",
                  "// k8s (https, Traefik): the ingress decodes and resolves the path to /api/v1/users before the Gateway,",
                  "// which requires a token there (401). In both cases nothing reaches a service.",
                  "const k8s = /^https:/.test(pm.variables.get('gatewayUrl'));",
                  "const expected = k8s",
                  "  ? { status: 401, error: 'UNAUTHORIZED', message: 'Missing or invalid access token' }",
                  "  : { status: 400, error: 'VALIDATION_ERROR', message: 'Invalid request path' };",
                  "pm.test(`status is ${expected.status} (${k8s ? 'k8s: path resolved by Traefik' : 'compose'})`, () => pm.expect(pm.response.code).to.equal(expected.status));",
                  "pm.test('Gateway error in the team format', () => {",
                  "  pm.expect(pm.response.json()).to.eql({ ...expected, requestId: pm.response.headers.get('X-Request-Id') });",
                  "});",
                  "pm.test('no X-Instance-Id (the answer of the Gateway, not of a service)', () => pm.expect(pm.response.headers.has('X-Instance-Id')).to.be.false);",
                  "pm.test('X-Gateway-Instance-Id header starts with api-gateway-', () => pm.expect(pm.response.headers.get('X-Gateway-Instance-Id')).to.match(/^api-gateway-/));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gatewayUrl}}/products/%2e%2e/users",
            "description": "A non-canonical path (encoded ..) never reaches a service. Through nginx (compose, http) the Gateway gets it as is and answers 400; Traefik (k8s, https) resolves it to /users first, so the Gateway answers 401 there."
          }
        },
        {
          "name": "Path with a semicolon (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));",
                  "const body = pm.response.json();",
                  "pm.test('Gateway error 400 VALIDATION_ERROR in the team format', () => {",
                  "  pm.expect(body).to.eql({ status: 400, error: 'VALIDATION_ERROR', message: 'Invalid request path', requestId: pm.response.headers.get('X-Request-Id') });",
                  "});",
                  "pm.test('no X-Instance-Id (the answer of the Gateway, not of a service)', () => pm.expect(pm.response.headers.has('X-Instance-Id')).to.be.false);",
                  "pm.test('X-Gateway-Instance-Id header starts with api-gateway-', () => pm.expect(pm.response.headers.get('X-Gateway-Instance-Id')).to.match(/^api-gateway-/));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gatewayUrl}}/products/a;b=1",
            "description": "A path parameter (;) is not canonical: 400 before routing in compose and in k8s."
          }
        },
        {
          "name": "Unknown resource (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 404', () => pm.response.to.have.status(404));",
                  "const body = pm.response.json();",
                  "pm.test('Gateway error 404 NOT_FOUND in the team format', () => {",
                  "  pm.expect(body).to.eql({ status: 404, error: 'NOT_FOUND', message: 'Not found', requestId: pm.response.headers.get('X-Request-Id') });",
                  "});",
                  "pm.test('no X-Instance-Id (the answer of the Gateway, not of a service)', () => pm.expect(pm.response.headers.has('X-Instance-Id')).to.be.false);",
                  "pm.test('X-Gateway-Instance-Id header starts with api-gateway-', () => pm.expect(pm.response.headers.get('X-Gateway-Instance-Id')).to.match(/^api-gateway-/));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gatewayUrl}}/nie-ma",
            "description": "No route for the first path segment."
          }
        }
      ],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// shop:error-format",
              "// Every answer through the Gateway has X-Request-Id; every error: {status (= HTTP code), error, message,",
              "// requestId = X-Request-Id of the answer}. Not for Mailpit (other format).",
              "const url = pm.variables.replaceIn(pm.request.url.toString());",
              "const external = ['mailpitUrl', 'rabbitmqUrl'].some((name) => {",
              "  const base = pm.variables.get(name);",
              "  return Boolean(base) && url.startsWith(base);",
              "});",
              "if (!external) {",
              "  pm.test('X-Request-Id header is set', () => pm.expect(pm.response.headers.get('X-Request-Id')).to.be.a('string').and.not.empty);",
              "  if (pm.response.code >= 400) {",
              "    pm.test(`error ${pm.response.code} in the team format, requestId = X-Request-Id`, () => {",
              "      const body = pm.response.json();",
              "      pm.expect(body.status, 'status').to.eql(pm.response.code);",
              "      pm.expect(body.error, 'error').to.be.a('string').and.not.empty;",
              "      pm.expect(body.message, 'message').to.be.a('string').and.not.empty;",
              "      pm.expect(body.requestId, 'requestId').to.eql(pm.response.headers.get('X-Request-Id'));",
              "    });",
              "  }",
              "}"
            ]
          }
        }
      ]
    }
  ]
}
