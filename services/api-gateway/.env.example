# API Gateway environment variables: names only, never commit values.
# Local run (VS Code): pass the values as environment variables of the process (README.md, "Uruchomienie z VS Code").
# In Docker Compose the values come from deploy/compose.yaml and deploy/.env.

# HTTP port of the Gateway, locally 8080 (18080 while the Gateway from Compose uses 8080).
PORT=
# Optional. Overrides logLevel from Consul KV (fatal, error, warn, info, debug, trace).
LOG_LEVEL=

# Consul agent, locally 127.0.0.1 and 8500. The Gateway always uses Consul (configuration, registration, instances).
CONSUL_HOST=
CONSUL_PORT=
# Address registered in Consul, locally host.docker.internal. Empty means the local address of the route
# to the Consul agent; a loopback address there (e.g. CONSUL_HOST=127.0.0.1) stops the startup.
SERVICE_ADDRESS=

# Redis for the rate limit counters (redis-gateway), locally 127.0.0.1 and 6379.
REDIS_HOST=
REDIS_PORT=
# Required. Value of REDIS_GATEWAY_PASSWORD from deploy/.env.
REDIS_PASSWORD=

# Optional. Override jwt.issuer and jwt.audience from Consul KV.
JWT_ISSUER=
JWT_AUDIENCE=
