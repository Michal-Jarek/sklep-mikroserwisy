# API Gateway environment variables: names only, never commit values.
# Local run (VS Code): pass the values as environment variables of the process (README.md, "Uruchomienie z VS Code").
# In Docker Compose the values come from deploy/compose.yaml and deploy/.env.

# HTTP port of the Gateway, locally 8080 (18080 while the Gateway from Compose uses 8080).
PORT=
# Optional. Overrides logLevel from Consul KV (fatal, error, warn, info, debug, trace).
LOG_LEVEL=

# Consul agent, locally 127.0.0.1 and 8500. The Gateway always uses Consul (configuration, registration, instances).
CONSUL_HOST=
CONSUL_PORT=
# Optional. Consul ACL token, sent as X-Consul-Token in every Consul call (Kubernetes: Secret api-gateway-secret).
# Empty means no token (Docker Compose, Consul without ACL).
CONSUL_HTTP_TOKEN=
# Address registered in Consul, locally host.docker.internal. Empty means the local address of the route
# to the Consul agent; a loopback address there (e.g. CONSUL_HOST=127.0.0.1) stops the startup.
SERVICE_ADDRESS=
# Optional, unique per instance. Instance id (Consul ID, X-Gateway-Instance-Id header, logs); 1-128 characters
# [A-Za-z0-9._-]. Empty -> api-gateway-<hostname>. Kubernetes sets it to the pod name.
INSTANCE_ID=

# Redis for the rate limit counters (redis-gateway), locally 127.0.0.1 and 6379.
REDIS_HOST=
REDIS_PORT=
# Required. Value of REDIS_GATEWAY_PASSWORD from deploy/.env.
REDIS_PASSWORD=

# Optional. Override jwt.issuer and jwt.audience from Consul KV.
JWT_ISSUER=
JWT_AUDIENCE=

# Optional. Comma-separated addresses, CIDR ranges or host names of proxies whose X-Forwarded-For gives the client
# address (Docker Compose: frontend). Empty means nobody is trusted: the connection address counts.
TRUSTED_PROXIES=

# Optional. http(s)://host[:port] of Auth Service for the JWKS, without a path (Kubernetes:
# http://auth-service.shop.svc.cluster.local:8081). Empty means an auth-service instance from Consul (Docker Compose).
AUTH_JWKS_ORIGIN=
