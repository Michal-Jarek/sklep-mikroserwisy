# Copy to .env (never committed) for work from VS Code or a terminal; docs/patterns.md, section 1.
# Values for the laptop with the shared infrastructure from deploy/compose.yaml.
HOST=127.0.0.1
PORT=8087
CONSUL_HOST=127.0.0.1
CONSUL_PORT=8500
# Consul (in a container) checks /health/ready of the service on the laptop at this address.
SERVICE_ADDRESS=host.docker.internal
DB_HOST=127.0.0.1
DB_PORT=27017
DB_NAME=notification_db
DB_USER=notification_service
# The value of NOTIFICATION_DB_PASSWORD from deploy/.env (see README).
DB_PASSWORD=
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=notification-service
# The value of NOTIFICATION_RABBITMQ_PASSWORD from deploy/.env (see README).
RABBITMQ_PASSWORD=
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# Optional:
# LOG_LEVEL=debug
# MAIL_FROM=Sklep <sklep@sklep.local>
# USER_SERVICE_URL=http://127.0.0.1:8082
