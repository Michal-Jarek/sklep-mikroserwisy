{
  "info": {
    "name": "user-service (bezpośrednio, lokalnie)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8082"
    },
    {
      "key": "userId",
      "value": "11111111-1111-4111-8111-111111111111"
    },
    {
      "key": "productId",
      "value": "22222222-2222-4222-8222-222222222222"
    },
    {
      "key": "addressId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Utwórz profil (Auth)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-User-Id",
            "value": "{{userId}}"
          },
          {
            "key": "X-User-Roles",
            "value": "SERVICE"
          },
          {
            "key": "X-Request-Id",
            "value": "postman-demo"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/users",
        "body": {
          "mode": "raw",
          "raw": "{\"id\": \"{{userId}}\", \"firstName\": \"Anna\", \"lastName\": \"Nowak\", \"email\": \"anna@example.com\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "Mój profil",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-User-Id",
            "value": "{{userId}}"
          },
          {
            "key": "X-User-Roles",
            "value": "CUSTOMER"
          },
          {
            "key": "X-Request-Id",
            "value": "postman-demo"
          }
        ],
        "url": "{{baseUrl}}/users/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Zmień profil",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "X-User-Id",
            "value": "{{userId}}"
          },
          {
            "key": "X-User-Roles",
            "value": "CUSTOMER"
          },
          {
            "key": "X-Request-Id",
            "value": "postman-demo"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/users/me",
        "body": {
          "mode": "raw",
          "raw": "{\"firstName\": \"Anna\", \"lastName\": \"Kowalska\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Profil dla Notification",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-User-Id",
            "value": "{{userId}}"
          },
          {
            "key": "X-User-Roles",
            "value": "SERVICE"
          },
          {
            "key": "X-Request-Id",
            "value": "postman-demo"
          }
        ],
        "url": "{{baseUrl}}/users/{{userId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Dodaj adres",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-User-Id",
            "value": "{{userId}}"
          },
          {
            "key": "X-User-Roles",
            "value": "CUSTOMER"
          },
          {
            "key": "X-Request-Id",
            "value": "postman-demo"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/users/me/addresses",
        "body": {
          "mode": "raw",
          "raw": "{\"street\": \"Lipowa 1\", \"city\": \"Warszawa\", \"postalCode\": \"00-001\", \"countryCode\": \"PL\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"addressId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Lista adresów",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-User-Id",
            "value": "{{userId}}"
          },
          {
            "key": "X-User-Roles",
            "value": "CUSTOMER"
          },
          {
            "key": "X-Request-Id",
            "value": "postman-demo"
          }
        ],
        "url": "{{baseUrl}}/users/me/addresses"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Usuń adres",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "X-User-Id",
            "value": "{{userId}}"
          },
          {
            "key": "X-User-Roles",
            "value": "CUSTOMER"
          },
          {
            "key": "X-Request-Id",
            "value": "postman-demo"
          }
        ],
        "url": "{{baseUrl}}/users/me/addresses/{{addressId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    }
  ]
}
