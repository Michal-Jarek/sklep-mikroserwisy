              {
                "key": "X-User-Roles",
                "value": "CUSTOMER"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/users/me",
            "body": {
              "mode": "raw",
              "raw": "{\"firstName\": \"Anna\", \"lastName\": \"Kowalska\"}"
