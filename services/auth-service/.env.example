# Auth Service environment variables: names only, never commit values.
# Local run (VS Code): copy to .env and fill in the values from README.md. In Docker Compose
# the values come from deploy/compose.yaml and deploy/.env.

# HTTP port of the service.
PORT=
# Optional. Overrides logLevel from Consul KV (fatal, error, warn, info, debug, trace).
LOG_LEVEL=

# "false" disables the Consul registration and the KV read.
CONSUL_ENABLED=
CONSUL_HOST=
CONSUL_PORT=
# Address registered in Consul. Empty means the first non-loopback IPv4 of the container.
SERVICE_ADDRESS=

# PostgreSQL connection (database auth_db, role auth_service).
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
# Value of AUTH_DB_PASSWORD from deploy/.env.
DB_PASSWORD=
# Only for "npx prisma migrate dev" (local): shadow database auth_shadow_db.
DB_SHADOW_NAME=

# RabbitMQ connection for the user.registered events (account auth-service, vhost /).
# Required, but Auth starts and registers users without a running broker (events wait in the outbox).
RABBITMQ_HOST=
# Default: 5672.
RABBITMQ_PORT=
RABBITMQ_USER=
# Value of AUTH_RABBITMQ_PASSWORD from deploy/.env.
RABBITMQ_PASSWORD=

# RS256 private key for access tokens (PKCS#8 PEM file), locally ../../deploy/secrets/jwt-private.pem.
JWT_PRIVATE_KEY_FILE=
# Optional. Override jwt.issuer and jwt.audience from Consul KV.
JWT_ISSUER=
JWT_AUDIENCE=

# First admin account, created at startup when it does not exist. Both empty: no admin account.
# Only one of them, an invalid email or a password outside 10-72 bytes stops the startup.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# "false": registration does not call User Service (POST /users). Default: true.
USER_SERVICE_ENABLED=
