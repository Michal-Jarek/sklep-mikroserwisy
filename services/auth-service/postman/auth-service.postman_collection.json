    {
      "name": "jwks",
      "item": [
        {
          "name": "JWKS returns the public key",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('X-Request-Id header is set', () => pm.expect(pm.response.headers.get('X-Request-Id')).to.be.a('string').and.not.empty);",
                  "pm.test('X-Instance-Id header starts with auth-service-', () => pm.expect(pm.response.headers.get('X-Instance-Id')).to.match(/^auth-service-/));",
                  "const keys = pm.response.json().keys;",
                  "pm.test('one RSA signing key', () => {",
                  "  pm.expect(keys).to.have.lengthOf(1);",
                  "  pm.expect(keys[0]).to.include({ kty: 'RSA', alg: 'RS256', use: 'sig' });",
                  "});",
                  "pm.test('only public members', () => pm.expect(Object.keys(keys[0]).sort()).to.eql(['alg', 'e', 'kid', 'kty', 'n', 'use']));",
                  "pm.collectionVariables.set('jwksKid', keys[0].kid);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/.well-known/jwks.json",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                ".well-known",
                "jwks.json"
              ]
            },
            "description": "Public key for verifying access tokens (used by the Gateway). Only kty, n, e, kid, alg, use; never private members."
          }
        }
      ]
    },
    {
      "name": "register",
      "item": [
        {
          "name": "Register a new account (201)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A new email on every run, so the collection can be run many times.",
                  "const email = `postman-${Date.now()}-${Math.floor(Math.random() * 1e6)}@example.com`;",
                  "pm.collectionVariables.set('email', email);",
                  "pm.collectionVariables.set('emailMixedCase', email.toUpperCase());",
                  "pm.collectionVariables.set('password', 'Postman-Pass-123');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('X-Request-Id header is set', () => pm.expect(pm.response.headers.get('X-Request-Id')).to.be.a('string').and.not.empty);",
                  "pm.test('X-Instance-Id header starts with auth-service-', () => pm.expect(pm.response.headers.get('X-Instance-Id')).to.match(/^auth-service-/));",
                  "const body = pm.response.json();",
                  "pm.test('account in the response, email in lower case', () => {",
                  "  pm.expect(body.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/);",
                  "  pm.expect(body.email).to.eql(pm.collectionVariables.get('email'));",
                  "  pm.expect(body.firstName).to.eql('Postman');",
                  "  pm.expect(body.lastName).to.eql('Tester');",
                  "  pm.expect(body.roles).to.eql(['CUSTOMER']);",
                  "});",
                  "pm.test('no other fields (no password hash, no tokens)', () => pm.expect(Object.keys(body).sort()).to.eql(['email', 'firstName', 'id', 'lastName', 'roles']));",
                  "pm.collectionVariables.set('accountId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
