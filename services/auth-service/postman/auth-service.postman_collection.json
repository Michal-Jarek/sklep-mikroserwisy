    {
      "name": "login",
      "description": "Three login requests per run (two here, one in session): Auth allows 5 login requests per minute from one IP address, so run the collection again only after 60 s.",
      "item": [
        {
          "name": "Log in (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('X-Request-Id header is set', () => pm.expect(pm.response.headers.get('X-Request-Id')).to.be.a('string').and.not.empty);",
                  "pm.test('X-Instance-Id header starts with auth-service-', () => pm.expect(pm.response.headers.get('X-Instance-Id')).to.match(/^auth-service-/));",
                  "const body = pm.response.json();",
                  "pm.test('token response', () => {",
                  "  pm.expect(body.tokenType).to.eql('Bearer');",
                  "  pm.expect(body.expiresIn).to.eql(900);",
                  "  pm.expect(body.accessToken.split('.')).to.have.lengthOf(3);",
                  "});",
                  "const decode = (part) => {",
                  "  const base64 = part.replace(/-/g, '+').replace(/_/g, '/');",
                  "  return JSON.parse(atob(base64 + '='.repeat((4 - (base64.length % 4)) % 4)));",
                  "};",
                  "const [header, payload] = body.accessToken.split('.').map((part, i) => (i < 2 ? decode(part) : part));",
                  "pm.test('header: RS256 and the kid from JWKS', () => {",
                  "  pm.expect(header.alg).to.eql('RS256');",
                  "  pm.expect(header.kid).to.eql(pm.collectionVariables.get('jwksKid'));",
                  "});",
                  "pm.test('claims: sub, roles, 900 s lifetime, no email', () => {",
                  "  pm.expect(payload.sub).to.eql(pm.collectionVariables.get('accountId'));",
                  "  pm.expect(payload.roles).to.eql(['CUSTOMER']);",
                  "  pm.expect(payload.exp - payload.iat).to.eql(900);",
                  "  pm.expect(payload).to.not.have.property('email');",
                  "});",
                  "pm.collectionVariables.set('accessToken', body.accessToken);",
                  "const parseCookie = () => {",
                  "  const header = pm.response.headers.get('Set-Cookie') || '';",
                  "  const [first, ...attributes] = header.split(';').map((part) => part.trim());",
                  "  const separator = first.indexOf('=');",
                  "  const cookie = { name: first.slice(0, separator), value: first.slice(separator + 1) };",
                  "  for (const attribute of attributes) {",
                  "    const [name, ...value] = attribute.split('=');",
                  "    cookie[name.toLowerCase()] = value.join('=');",
                  "  }",
                  "  return cookie;",
                  "};",
                  "const cookie = parseCookie();",
                  "pm.test('Set-Cookie: refresh_token with HttpOnly, Secure, SameSite=Strict, Path=/api/v1/auth, Max-Age=604800', () => {",
                  "  pm.expect(cookie.name).to.eql('refresh_token');",
                  "  pm.expect(cookie.value).to.match(/^[A-Za-z0-9_-]{43}$/);",
                  "  pm.expect(cookie['max-age']).to.eql('604800');",
                  "  pm.expect(cookie.path).to.eql('/api/v1/auth');",
                  "  pm.expect(cookie).to.have.property('httponly');",
                  "  pm.expect(cookie).to.have.property('secure');",
                  "  pm.expect(cookie.samesite).to.eql('Strict');",
                  "});",
                  "pm.test('refresh token is not in the body', () => pm.expect(pm.response.text()).to.not.include(cookie.value));",
                  "// The cookie has Path=/api/v1/auth (the Gateway path), so Postman would not send it to /auth/refresh by itself:",
                  "// the value is kept in a variable and sent in a Cookie header.",
                  "pm.collectionVariables.set('refreshToken', cookie.value);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Returns an RS256 access token valid for 900 s (saved as accessToken) and sets the refresh_token cookie (HttpOnly, Secure, SameSite=Strict, Path=/api/v1/auth, 7 days). The token has sub (account id), roles, iss, aud, iat, exp and no email. The cookie value is saved as refreshToken.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          }
        },
        {
          "name": "Log in with a wrong password (401 INVALID_CREDENTIALS)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('X-Request-Id header is set', () => pm.expect(pm.response.headers.get('X-Request-Id')).to.be.a('string').and.not.empty);",
                  "pm.test('X-Instance-Id header starts with auth-service-', () => pm.expect(pm.response.headers.get('X-Instance-Id')).to.match(/^auth-service-/));",
                  "const body = pm.response.json();",
                  "pm.test('error format', () => {",
                  "  pm.expect(body.status).to.eql(401);",
                  "  pm.expect(body.error).to.eql('INVALID_CREDENTIALS');",
                  "  pm.expect(body.message).to.be.a('string');",
                  "  pm.expect(body.requestId).to.eql(pm.response.headers.get('X-Request-Id'));",
                  "  pm.expect(body).to.not.have.property('stack');",
                  "});",
                  "pm.test('no refresh token cookie', () => pm.expect(pm.response.headers.has('Set-Cookie')).to.be.false);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "A wrong password and an unknown email give the same answer.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"wrong-password-123\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "session",
      "description": "Refresh token rotation, reuse detection and logout. Uses the account and the refresh token from the register and login folders.",
      "item": [
        {
          "name": "Refresh the session (200, rotation)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('X-Request-Id header is set', () => pm.expect(pm.response.headers.get('X-Request-Id')).to.be.a('string').and.not.empty);",
                  "pm.test('X-Instance-Id header starts with auth-service-', () => pm.expect(pm.response.headers.get('X-Instance-Id')).to.match(/^auth-service-/));",
                  "const body = pm.response.json();",
                  "pm.test('token response', () => {",
                  "  pm.expect(Object.keys(body).sort()).to.eql(['accessToken', 'expiresIn', 'tokenType']);",
                  "  pm.expect(body.tokenType).to.eql('Bearer');",
                  "  pm.expect(body.expiresIn).to.eql(900);",
                  "  pm.expect(body.accessToken.split('.')).to.have.lengthOf(3);",
                  "});",
                  "const decode = (part) => {",
                  "  const base64 = part.replace(/-/g, '+').replace(/_/g, '/');",
                  "  return JSON.parse(atob(base64 + '='.repeat((4 - (base64.length % 4)) % 4)));",
                  "};",
                  "const payload = decode(body.accessToken.split('.')[1]);",
                  "pm.test('new access token for the same account, roles from the database', () => {",
                  "  pm.expect(payload.sub).to.eql(pm.collectionVariables.get('accountId'));",
                  "  pm.expect(payload.roles).to.eql(['CUSTOMER']);",
                  "});",
                  "const parseCookie = () => {",
                  "  const header = pm.response.headers.get('Set-Cookie') || '';",
                  "  const [first, ...attributes] = header.split(';').map((part) => part.trim());",
                  "  const separator = first.indexOf('=');",
                  "  const cookie = { name: first.slice(0, separator), value: first.slice(separator + 1) };",
                  "  for (const attribute of attributes) {",
                  "    const [name, ...value] = attribute.split('=');",
                  "    cookie[name.toLowerCase()] = value.join('=');",
                  "  }",
                  "  return cookie;",
                  "};",
                  "const cookie = parseCookie();",
                  "pm.test('Set-Cookie: refresh_token with HttpOnly, Secure, SameSite=Strict, Path=/api/v1/auth, Max-Age=604800', () => {",
                  "  pm.expect(cookie.name).to.eql('refresh_token');",
                  "  pm.expect(cookie.value).to.match(/^[A-Za-z0-9_-]{43}$/);",
                  "  pm.expect(cookie['max-age']).to.eql('604800');",
                  "  pm.expect(cookie.path).to.eql('/api/v1/auth');",
                  "  pm.expect(cookie).to.have.property('httponly');",
                  "  pm.expect(cookie).to.have.property('secure');",
                  "  pm.expect(cookie.samesite).to.eql('Strict');",
                  "});",
                  "pm.test('refresh token is not in the body', () => pm.expect(pm.response.text()).to.not.include(cookie.value));",
                  "pm.test('new refresh token (rotation)', () => pm.expect(cookie.value).to.not.eql(pm.collectionVariables.get('refreshToken')));",
                  "pm.collectionVariables.set('previousRefreshToken', pm.collectionVariables.get('refreshToken'));",
                  "// The cookie has Path=/api/v1/auth (the Gateway path), so Postman would not send it to /auth/refresh by itself:",
                  "// the value is kept in a variable and sent in a Cookie header.",
                  "pm.collectionVariables.set('refreshToken', cookie.value);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Cookie",
                "value": "refresh_token={{refreshToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            },
            "description": "Sends the refresh token from the login (Cookie header, empty body). Returns a new access token and a new refresh_token cookie; the old token is revoked."
          }
        },
        {
          "name": "Refresh with the replaced token (401 UNAUTHORIZED, reuse)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('X-Request-Id header is set', () => pm.expect(pm.response.headers.get('X-Request-Id')).to.be.a('string').and.not.empty);",
                  "pm.test('X-Instance-Id header starts with auth-service-', () => pm.expect(pm.response.headers.get('X-Instance-Id')).to.match(/^auth-service-/));",
                  "const body = pm.response.json();",
                  "pm.test('error format', () => {",
                  "  pm.expect(body.status).to.eql(401);",
                  "  pm.expect(body.error).to.eql('UNAUTHORIZED');",
