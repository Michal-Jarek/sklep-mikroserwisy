    {
      "name": "errors",
      "item": [
        {
          "name": "Unknown path returns 404 NOT_FOUND",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 404', () => pm.response.to.have.status(404));",
                  "pm.test('X-Request-Id header is set', () => pm.expect(pm.response.headers.get('X-Request-Id')).to.be.a('string').and.not.empty);",
                  "pm.test('X-Instance-Id header starts with auth-service-', () => pm.expect(pm.response.headers.get('X-Instance-Id')).to.match(/^auth-service-/));",
                  "const body = pm.response.json();",
                  "pm.test('error format', () => {",
                  "  pm.expect(body.status).to.eql(404);",
                  "  pm.expect(body.error).to.eql('NOT_FOUND');",
                  "  pm.expect(body.message).to.be.a('string');",
                  "  pm.expect(body).to.not.have.property('stack');",
                  "});",
                  "pm.test('requestId is the one sent by the client', () => {",
                  "  pm.expect(body.requestId).to.eql('postman-404');",
                  "  pm.expect(pm.response.headers.get('X-Request-Id')).to.eql('postman-404');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Request-Id",
                "value": "postman-404"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/no-such-path",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "no-such-path"
              ]
            },
            "description": "Every error uses the team format {status, error, message, requestId}. A valid X-Request-Id from the client is kept."
          }
        }
      ]
