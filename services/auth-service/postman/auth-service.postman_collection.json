            "description": "Creates a CUSTOMER account. The email is trimmed and stored in lower case. Run Auth with USER_SERVICE_ENABLED=false when User Service is not running. Does not log in (no tokens).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"  {{emailMixedCase}}  \",\n  \"password\": \"{{password}}\",\n  \"firstName\": \"Postman\",\n  \"lastName\": \"Tester\"\n}"
