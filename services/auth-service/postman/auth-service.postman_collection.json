{
  "info": {
    "name": "auth-service",
    "description": "Auth Service called directly (without the Gateway). Set baseUrl in the environment, e.g. http://localhost:8081 when the service runs from VS Code. Run the folders in order; at most one run per minute (login limit per IP).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "health",
      "item": [
        {
          "name": "Liveness",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('X-Request-Id header is set', () => pm.expect(pm.response.headers.get('X-Request-Id')).to.be.a('string').and.not.empty);",
                  "pm.test('X-Instance-Id header starts with auth-service-', () => pm.expect(pm.response.headers.get('X-Instance-Id')).to.match(/^auth-service-/));",
                  "pm.test('body is {\"status\":\"UP\"}', () => pm.expect(pm.response.json()).to.eql({ status: 'UP' }));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/live",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                "live"
              ]
            },
            "description": "The process is alive; dependencies are not checked."
          }
        },
        {
          "name": "Readiness",
          "event": [
