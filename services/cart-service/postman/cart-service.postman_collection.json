{
  "info": {
    "name": "cart-service (bezpośrednio, lokalnie)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8085"
    },
    {
      "key": "userId",
      "value": "11111111-1111-4111-8111-111111111111"
    },
    {
      "key": "productId",
      "value": "22222222-2222-4222-8222-222222222222"
    }
  ],
  "item": [
    {
      "name": "start",
      "description": "Identical in all 10 service collections. Registers a new customer, logs in the customer and the admin, and keeps customerToken, customerId, customerEmail and adminToken in the environment. The runner runs it once per run.",
      "item": [
        {
          "name": "Register a new customer",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A new customer on every run: random e-mail and random password (24 characters; Auth needs 10-72 bytes).",
                  "// The password lives only in a local variable of this run (pm.variables), never in the environment.",
                  "const chars = 'abcdefghijkmnopqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ23456789';",
                  "const random = (n) => Array.from({ length: n }, () => chars[Math.floor(Math.random() * chars.length)]).join('');",
                  "pm.variables.set('customerPassword', random(24));",
                  "pm.environment.set('customerEmail', `postman-${Date.now().toString(36)}-${random(8).toLowerCase()}@sklep.local`);",
                  "['customerToken', 'customerId', 'adminToken'].forEach((name) => pm.environment.unset(name));",
                  "pm.request.body.update(JSON.stringify({",
                  "  email: pm.environment.get('customerEmail'),",
                  "  password: pm.variables.get('customerPassword'),",
                  "  firstName: 'Postman',",
                  "  lastName: 'Customer',",
                  "}));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const account = pm.response.json();",
                  "pm.test('account: id UUID, the generated e-mail, roles [\"CUSTOMER\"], no tokens in the body', () => {",
                  "  pm.expect(account.id, 'id').to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/);",
                  "  pm.expect(account.email, 'email').to.eql(pm.environment.get('customerEmail'));",
                  "  pm.expect(account.roles, 'roles').to.eql(['CUSTOMER']);",
                  "  pm.expect('accessToken' in account, 'accessToken in the body').to.be.false;",
                  "});",
                  "pm.environment.set('customerId', account.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gatewayUrl}}/auth/register",
            "description": "New customer of this run (e-mail postman-<random>@sklep.local). The body is built in the pre-request script.",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Log in as the customer",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.request.body.update(JSON.stringify({",
                  "  email: pm.environment.get('customerEmail'),",
                  "  password: pm.variables.get('customerPassword'),",
                  "}));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Payload of a JWT (base64url). Only the claims are checked; the token is never printed or compared by value.",
                  "const decodeBase64 = require('atob');",
                  "const jwtClaims = (token) => {",
                  "  const part = token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');",
                  "  return JSON.parse(decodeBase64(part + '='.repeat((4 - (part.length % 4)) % 4)));",
                  "};",
                  "",
                  "            pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "            const login = pm.response.json();",
                  "            pm.test('Bearer access token of the new customer (sub = customerId, roles [\"CUSTOMER\"])', () => {",
                  "              pm.expect(login.tokenType, 'tokenType').to.eql('Bearer');",
                  "              pm.expect(login.accessToken, 'accessToken').to.be.a('string');",
                  "              pm.expect(login.accessToken.split('.').length, 'parts of the JWT').to.eql(3);",
                  "              const claims = jwtClaims(login.accessToken);",
                  "              pm.expect(claims.sub, 'sub').to.eql(pm.environment.get('customerId'));",
                  "              pm.expect(claims.roles, 'roles').to.eql(['CUSTOMER']);",
                  "            });",
                  "            // Only the attributes are compared; the cookie value is never printed. The cookie stays in the cookie jar.",
                  "            pm.test('Set-Cookie refresh_token: HttpOnly, Secure, SameSite=Strict, Path=/api/v1/auth', () => {",
                  "              const parts = (pm.response.headers.get('Set-Cookie') || '').split(';').map((part) => part.trim());",
                  "              pm.expect(/^refresh_token=[^\\s]+$/.test(parts[0]), 'refresh_token cookie').to.be.true;",
                  "              ['HttpOnly', 'Secure', 'SameSite=Strict', 'Path=/api/v1/auth'].forEach((attribute) => {",
                  "                pm.expect(parts.slice(1).includes(attribute), attribute).to.be.true;",
                  "              });",
                  "            });",
                  "            if (typeof login.accessToken === 'string') {",
                  "              pm.environment.set('customerToken', login.accessToken);",
                  "            }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gatewayUrl}}/auth/login",
            "description": "Login 1 of 2 in a run (the Gateway allows 5 per minute per client address).",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Log in as admin",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// The body is built here, so any character of the password stays valid JSON.",
                  "pm.request.body.update(JSON.stringify({ email: pm.variables.get('adminEmail'), password: pm.variables.get('adminPassword') }));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Payload of a JWT (base64url). Only the claims are checked; the token is never printed or compared by value.",
                  "const decodeBase64 = require('atob');",
                  "const jwtClaims = (token) => {",
                  "  const part = token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');",
                  "  return JSON.parse(decodeBase64(part + '='.repeat((4 - (part.length % 4)) % 4)));",
                  "};",
                  "",
                  "            pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "            const login = pm.response.json();",
                  "            pm.test('Bearer access token with the role ADMIN', () => {",
                  "              pm.expect(login.tokenType, 'tokenType').to.eql('Bearer');",
                  "              pm.expect(login.accessToken, 'accessToken').to.be.a('string');",
                  "              pm.expect(jwtClaims(login.accessToken).roles, 'roles').to.include('ADMIN');",
                  "            });",
                  "            if (typeof login.accessToken === 'string') {",
                  "              pm.environment.set('adminToken', login.accessToken);",
                  "            }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gatewayUrl}}/auth/login",
            "description": "Login 2 of 2 in a run. adminEmail and adminPassword come from the environment (the password only from the runner, never in a file). Cookie jar disabled: the refresh_token cookie of the admin must not replace the one of the customer (same path).",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "protocolProfileBehavior": {
            "disableCookies": true
          }
        }
      ]
    },
    {
      "name": "direct",
      "description": "Straight to the service in the compose network sklep_backend (runner only): headers X-User-Id, X-User-Roles set by hand, as the Gateway does. Data of other services prepared in the same run through {{<name>Url}}; cleaned up at the end.",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// shop:direct-request-id",
              "// A new X-Request-Id for every request (the Gateway sets it in production); kept when the request sets its own.",
              "const sent = pm.request.headers.get('X-Request-Id');",
              "if (!sent) {",
              "  pm.request.headers.upsert({ key: 'X-Request-Id', value: pm.variables.replaceIn('{{$guid}}') });",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// shop:error-format",
              "// Every error of a service: {status (= HTTP code), error, message, requestId = the sent X-Request-Id}.",
              "// Not for Mailpit and the RabbitMQ management API (other formats).",
              "const url = pm.variables.replaceIn(pm.request.url.toString());",
              "const external = ['mailpitUrl', 'rabbitmqUrl'].some((name) => {",
              "  const base = pm.variables.get(name);",
              "  return Boolean(base) && url.startsWith(base);",
              "});",
              "if (!external && pm.response.code >= 400) {",
              "  pm.test(`error ${pm.response.code} in the team format, requestId = sent X-Request-Id`, () => {",
              "    const body = pm.response.json();",
              "    pm.expect(body.status, 'status').to.eql(pm.response.code);",
              "    pm.expect(body.error, 'error').to.be.a('string').and.not.empty;",
              "    pm.expect(body.message, 'message').to.be.a('string').and.not.empty;",
              "    pm.expect(body.requestId, 'requestId').to.eql(pm.variables.replaceIn(pm.request.headers.get('X-Request-Id')));",
              "  });",
              "}"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "Setup: own product (Product, ADMIN)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// New user ids and a run id for every run of this folder (fixed ids would meet the data of the",
                  "// previous run).",
                  "pm.variables.set('userId', pm.variables.replaceIn('{{$guid}}'));",
                  "pm.collectionVariables.set('userId', pm.variables.get('userId'));",
                  "pm.variables.set('adminUserId', pm.variables.replaceIn('{{$guid}}'));",
                  "pm.variables.set('runId', Date.now().toString(36));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('own product created: 201', () => pm.response.to.have.status(201));",
                  "const product = pm.response.code === 201 ? pm.response.json() : {};",
                  "pm.test('product: id UUID, price \"12.50\" PLN', () => {",
                  "  pm.expect(product.id, 'id').to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/);",
                  "  pm.expect(product.price, 'price').to.eql('12.50');",
                  "  pm.expect(product.currency, 'currency').to.eql('PLN');",
                  "});",
                  "pm.variables.set('productId', product.id);",
                  "pm.collectionVariables.set('productId', pm.variables.get('productId'));",
                  "console.log('own product of this run: ' + product.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{adminUserId}}"
              },
              {
                "key": "X-User-Roles",
                "value": "ADMIN"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{productServiceUrl}}/products",
            "description": "Own product of this run (Product, ADMIN); the seed products are only read.",
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"Postman cart-service {{runId}}\", \"description\": \"Created and deleted by the cart-service collection\", \"price\": \"12.50\", \"currency\": \"PLN\", \"categoryId\": \"c0000000-0000-4000-8000-000000000001\", \"imageUrl\": null}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Setup: stock of own product (Inventory, ADMIN)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('stock set: 200', () => pm.response.to.have.status(200));",
                  "pm.test('quantity 5, nothing reserved', () => {",
                  "  const stock = pm.response.json();",
                  "  pm.expect(stock.quantity, 'quantity').to.eql(5);",
                  "  pm.expect(stock.reserved, 'reserved').to.eql(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{adminUserId}}"
              },
              {
                "key": "X-User-Roles",
                "value": "ADMIN"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{inventoryServiceUrl}}/inventory/{{productId}}",
            "body": {
              "mode": "raw",
              "raw": "{\"quantity\": 5}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
