{
  "info": {
    "name": "cart-service (bezpośrednio, lokalnie)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8085"
    },
    {
      "key": "userId",
      "value": "11111111-1111-4111-8111-111111111111"
    },
    {
      "key": "productId",
      "value": "22222222-2222-4222-8222-222222222222"
    },
    {
      "key": "addressId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Koszyk",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-User-Id",
            "value": "{{userId}}"
          },
          {
            "key": "X-User-Roles",
            "value": "CUSTOMER"
          },
          {
            "key": "X-Request-Id",
            "value": "postman-demo"
          }
        ],
        "url": "{{baseUrl}}/cart"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Dodaj produkt",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-User-Id",
            "value": "{{userId}}"
          },
          {
            "key": "X-User-Roles",
            "value": "CUSTOMER"
          },
          {
            "key": "X-Request-Id",
            "value": "postman-demo"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/cart/items",
        "body": {
          "mode": "raw",
          "raw": "{\"productId\": \"{{productId}}\", \"quantity\": 2}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Zmień ilość",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "X-User-Id",
            "value": "{{userId}}"
          },
          {
            "key": "X-User-Roles",
            "value": "CUSTOMER"
          },
          {
            "key": "X-Request-Id",
            "value": "postman-demo"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/cart/items/{{productId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"quantity\": 1}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Usuń pozycję",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "X-User-Id",
            "value": "{{userId}}"
          },
          {
            "key": "X-User-Roles",
            "value": "CUSTOMER"
          },
          {
            "key": "X-Request-Id",
            "value": "postman-demo"
          }
        ],
        "url": "{{baseUrl}}/cart/items/{{productId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "Wyczyść po zakupie (Order)",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "X-User-Id",
            "value": "{{userId}}"
          },
          {
            "key": "X-User-Roles",
            "value": "SERVICE"
          },
          {
            "key": "X-Request-Id",
            "value": "postman-demo"
          }
        ],
        "url": "{{baseUrl}}/cart/{{userId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    }
  ]
}
