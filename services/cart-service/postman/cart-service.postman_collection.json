          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// No order in this folder: nothing is reserved.",
                  "// Asked again every 1 s, at most 10 more times (no fixed sleep).",
                  "const MAX_TRIES = 10;",
                  "const again = () => ({ url: pm.variables.replaceIn('{{inventoryServiceUrl}}/inventory/{{productId}}'), method: 'GET', header: [{ key: 'X-Request-Id', value: pm.variables.replaceIn('{{$guid}}') }] });",
                  "const ready = (res) => Boolean(res) && res.code === 200 && res.json().reserved === 0;",
                  "const check = (res) => {",
                  "  const stock = res && res.code === 200 ? res.json() : {};",
                  "  pm.test('stock of own product: 200, reserved 0, quantity 5', () => {",
                  "    pm.expect(res && res.code, 'status').to.eql(200);",
                  "    pm.expect(stock.reserved, 'reserved').to.eql(0);",
                  "    pm.expect(stock.quantity, 'quantity').to.eql(5);",
                  "  });",
                  "};",
                  "pm.test('first answer: 200', () => pm.response.to.have.status(200));",
                  "const wait = (tries, res) => {",
                  "  if (ready(res) || tries >= MAX_TRIES) {",
                  "    check(res);",
                  "    return;",
                  "  }",
                  "  setTimeout(() => pm.sendRequest(again(), (error, next) => wait(tries + 1, error ? null : next)), 1000);",
                  "};",
                  "wait(0, pm.response);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{inventoryServiceUrl}}/inventory/{{productId}}"
          }
        }
