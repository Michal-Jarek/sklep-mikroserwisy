                  "pm.test('at most ' + MAX_STALE + ' stale lines in the cart', () => pm.expect(stale.length).to.be.at.most(MAX_STALE));",
                  "stale.slice(0, MAX_STALE).forEach((line) => pm.sendRequest({",
