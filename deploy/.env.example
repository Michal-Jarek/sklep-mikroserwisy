# Do not put values here. deploy/.env is created by deploy/create-secrets.sh
# PostgreSQL superuser (administration only, not for services)
POSTGRES_PASSWORD=
# Service database users (<service>_service for database <service>_db)
AUTH_DB_PASSWORD=
USER_DB_PASSWORD=
PRODUCT_DB_PASSWORD=
INVENTORY_DB_PASSWORD=
ORDER_DB_PASSWORD=
SHIPPING_DB_PASSWORD=
# Redis for API Gateway (rate limiting)
REDIS_GATEWAY_PASSWORD=
# Password of the first Auth Service admin account (email: ADMIN_EMAIL, default admin@sklep.local)
ADMIN_PASSWORD=
