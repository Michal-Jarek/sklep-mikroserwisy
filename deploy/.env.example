# Do not put values here. deploy/.env is created by deploy/create-secrets.sh
# PostgreSQL superuser (administration only, not for services)
POSTGRES_PASSWORD=
# Service database users (<service>_service for database <service>_db)
AUTH_DB_PASSWORD=
USER_DB_PASSWORD=
PRODUCT_DB_PASSWORD=
INVENTORY_DB_PASSWORD=
ORDER_DB_PASSWORD=
SHIPPING_DB_PASSWORD=
# Redis for API Gateway (rate limiting)
REDIS_GATEWAY_PASSWORD=
# Password of the first Auth Service admin account (email: ADMIN_EMAIL, default admin@sklep.local)
ADMIN_PASSWORD=
# RabbitMQ admin account (management UI http://127.0.0.1:15672, user admin); set on the first start only
RABBITMQ_ADMIN_PASSWORD=
# RabbitMQ service accounts (user <service>-service, e.g. auth-service)
AUTH_RABBITMQ_PASSWORD=
NOTIFICATION_RABBITMQ_PASSWORD=
INVENTORY_RABBITMQ_PASSWORD=
SHIPPING_RABBITMQ_PASSWORD=
ORDER_RABBITMQ_PASSWORD=
# MongoDB admin account (user admin, administration only); set on the first start only
MONGO_ROOT_PASSWORD=
# MongoDB users of the service databases (<service>_service for database <service>_db)
REVIEW_DB_PASSWORD=
NOTIFICATION_DB_PASSWORD=
# Redis for Cart Service
REDIS_CART_PASSWORD=
# Consul ACL management token (UUID) for Kubernetes only: deploy/k8s/secrets.sh puts it into the
# Consul configuration and the KV seeding Job. Docker Compose does not use it (Consul without ACL there)
CONSUL_MANAGEMENT_TOKEN=
# Consul ACL tokens (UUID) of Auth Service and API Gateway for Kubernetes only: the only tokens that may
# register the names auth-service and api-gateway (Job consul-kv-seed creates them in Consul,
# deploy/k8s/secrets.sh puts them into auth-service-secret and api-gateway-secret). Docker Compose does not use them
CONSUL_AUTH_TOKEN=
CONSUL_GATEWAY_TOKEN=
