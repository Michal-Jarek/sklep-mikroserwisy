{
  "uid": "shop",
  "title": "Sklep",
  "description": "Sklep na mikroserwisach w Kubernetesie (przestrzeń shop): ruch przez API Gateway, zasoby podów, zdarzenia RabbitMQ i stan zbierania metryk.",
  "tags": [
    "shop"
  ],
  "editable": false,
  "graphTooltip": 1,
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {},
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "schemaVersion": 42,
  "annotations": {
    "list": []
  },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Usługa",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(gateway_http_requests_total, service)",
        "query": {
          "qryType": 1,
          "query": "label_values(gateway_http_requests_total, service)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
