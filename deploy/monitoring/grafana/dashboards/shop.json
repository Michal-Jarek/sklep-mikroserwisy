          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (code) (rate(gateway_http_requests_total{service=~\"$service\", code=~\"4..\"}[$__rate_interval]))",
          "legendFormat": "{{code}}",
          "range": true,
          "instant": false
