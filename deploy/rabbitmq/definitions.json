{
  "vhosts": [
    {
      "name": "/"
    }
  ],
  "exchanges": [
    {
      "name": "shop.events",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "shop.dlx",
      "vhost": "/",
      "type": "direct",
      "durable": true,
      "auto_delete": false,
      "internal": true,
      "arguments": {}
    }
  ],
  "queues": [
    {
      "name": "notification.q",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum"
      }
    },
    {
      "name": "notification.dlq",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum"
      }
    },
    {
      "name": "inventory.q",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum"
      }
    },
    {
      "name": "inventory.dlq",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum"
      }
    },
    {
      "name": "shipping.q",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum"
      }
    },
    {
      "name": "shipping.dlq",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum"
      }
    },
    {
      "name": "order.q",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum"
      }
    },
    {
      "name": "order.dlq",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum"
      }
    }
  ],
  "bindings": [
    {
      "source": "shop.events",
      "vhost": "/",
      "destination": "notification.q",
      "destination_type": "queue",
      "routing_key": "user.registered",
      "arguments": {}
    },
    {
      "source": "shop.events",
      "vhost": "/",
      "destination": "notification.q",
      "destination_type": "queue",
      "routing_key": "order.created",
      "arguments": {}
    },
    {
      "source": "shop.events",
      "vhost": "/",
      "destination": "shipping.q",
      "destination_type": "queue",
      "routing_key": "order.created",
      "arguments": {}
    },
    {
      "source": "shop.events",
      "vhost": "/",
      "destination": "notification.q",
      "destination_type": "queue",
      "routing_key": "order.cancelled",
      "arguments": {}
    },
    {
      "source": "shop.events",
      "vhost": "/",
      "destination": "inventory.q",
      "destination_type": "queue",
      "routing_key": "order.cancelled",
      "arguments": {}
    },
    {
      "source": "shop.events",
      "vhost": "/",
      "destination": "shipping.q",
      "destination_type": "queue",
      "routing_key": "order.cancelled",
      "arguments": {}
    },
    {
      "source": "shop.events",
      "vhost": "/",
      "destination": "notification.q",
      "destination_type": "queue",
      "routing_key": "shipment.status_changed",
      "arguments": {}
    },
    {
      "source": "shop.events",
      "vhost": "/",
      "destination": "inventory.q",
      "destination_type": "queue",
      "routing_key": "shipment.status_changed",
      "arguments": {}
