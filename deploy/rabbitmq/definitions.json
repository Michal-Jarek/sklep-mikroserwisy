    {
      "source": "shop.dlx",
      "vhost": "/",
      "destination": "order.dlq",
      "destination_type": "queue",
      "routing_key": "order.dlq",
      "arguments": {}
    }
  ],
  "policies": [
    {
      "vhost": "/",
      "name": "notification-retry",
      "pattern": "^notification\\.q$",
      "apply-to": "queues",
      "priority": 0,
      "definition": {
        "dead-letter-exchange": "shop.dlx",
        "dead-letter-routing-key": "notification.dlq",
        "delivery-limit": 2
      }
    },
    {
      "vhost": "/",
      "name": "inventory-retry",
      "pattern": "^inventory\\.q$",
      "apply-to": "queues",
      "priority": 0,
      "definition": {
        "dead-letter-exchange": "shop.dlx",
        "dead-letter-routing-key": "inventory.dlq",
        "delivery-limit": 2
      }
    },
    {
      "vhost": "/",
      "name": "shipping-retry",
      "pattern": "^shipping\\.q$",
      "apply-to": "queues",
      "priority": 0,
      "definition": {
        "dead-letter-exchange": "shop.dlx",
        "dead-letter-routing-key": "shipping.dlq",
        "delivery-limit": 2
      }
    },
    {
      "vhost": "/",
      "name": "order-retry",
      "pattern": "^order\\.q$",
      "apply-to": "queues",
      "priority": 0,
      "definition": {
        "dead-letter-exchange": "shop.dlx",
        "dead-letter-routing-key": "order.dlq",
        "delivery-limit": 2
      }
    }
  ]
}
