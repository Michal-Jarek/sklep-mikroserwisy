    {
      "source": "shop.events",
      "vhost": "/",
      "destination": "order.q",
      "destination_type": "queue",
      "routing_key": "shipment.status_changed",
      "arguments": {}
    },
    {
      "source": "shop.dlx",
      "vhost": "/",
      "destination": "notification.dlq",
      "destination_type": "queue",
      "routing_key": "notification.dlq",
      "arguments": {}
    },
    {
      "source": "shop.dlx",
      "vhost": "/",
      "destination": "inventory.dlq",
      "destination_type": "queue",
      "routing_key": "inventory.dlq",
      "arguments": {}
    },
    {
      "source": "shop.dlx",
      "vhost": "/",
      "destination": "shipping.dlq",
      "destination_type": "queue",
      "routing_key": "shipping.dlq",
      "arguments": {}
