# Zmienne frontendu (frontend/.env.local, nie trafia do repozytorium). Żadna nie jest tajna.

# Atrapy API (MSW) w trybie deweloperskim (`npm run dev`):
#   puste      – bez atrap, wszystkie żądania /api idą do API Gateway przez proxy Vite,
#   all        – atrapy wszystkich usług łącznie z Auth (to samo robi `npm run dev:mocks`),
#   lista      – tylko te zasoby (pierwszy segment ścieżki po /api/v1), reszta do Gateway, np.
#                users,cart,products,categories,inventory,reviews,orders,shipping,shipments
# W buildzie produkcyjnym (`npm run build`) zawsze puste.
VITE_API_MOCKS=

# Cel proxy /api serwera Vite (tylko proces Node, nie trafia do przeglądarki). Domyślnie http://127.0.0.1:8080.
API_PROXY_TARGET=
